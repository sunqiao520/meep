# Select one standalone SDK for headers, import libraries, runtime and license.
file(READ "${PROJECT_SOURCE_DIR}/tools/windows/dependencies.json" _meep_dependencies)
string(JSON MEEP_MKL_REQUIRED_VERSION GET "${_meep_dependencies}" oneMKL version)
string(JSON _meep_mkl_directory_version GET "${_meep_dependencies}" oneMKL directoryVersion)

# Visual Studio can remember -D cache overrides separately from CMakeCache.txt
# and replay the old pip SDK path even after "Delete Cache and Reconfigure".
# Migrate only Python SDK paths; an explicitly selected standalone SDK still
# takes precedence and must pass all of the validation below.
function(_meep_mkl_is_python_environment directory result)
  file(TO_CMAKE_PATH "${directory}" _directory)
  get_filename_component(_directory "${_directory}" REALPATH)
  string(TOLOWER "${_directory}" _directory)
  if(_directory MATCHES "/(\\.venv[^/]*|site-packages)(/|$)")
    set(${result} TRUE PARENT_SCOPE)
  else()
    set(${result} FALSE PARENT_SCOPE)
  endif()
endfunction()

if(MKL_ROOT)
  _meep_mkl_is_python_environment("${MKL_ROOT}" _meep_legacy_mkl_root)
  if(_meep_legacy_mkl_root)
    message(STATUS "Ignoring legacy Python MKL_ROOT '${MKL_ROOT}' from the IDE/cache; selecting a standalone Intel oneMKL SDK")
    unset(MKL_ROOT)
    unset(MKL_ROOT CACHE)
  endif()
endif()

if(NOT MKL_ROOT)
  if(DEFINED ENV{MKLROOT} AND NOT "$ENV{MKLROOT}" STREQUAL "")
    _meep_mkl_is_python_environment("$ENV{MKLROOT}" _meep_legacy_mkl_environment)
    if(_meep_legacy_mkl_environment)
      message(STATUS "Ignoring legacy Python MKLROOT environment value '$ENV{MKLROOT}'; selecting a standalone Intel oneMKL SDK")
    else()
      set(MKL_ROOT "$ENV{MKLROOT}")
    endif()
  endif()
  if(NOT MKL_ROOT AND EXISTS "${PROJECT_SOURCE_DIR}/windows.local.json")
    file(READ "${PROJECT_SOURCE_DIR}/windows.local.json" _meep_local)
    string(JSON MKL_ROOT ERROR_VARIABLE _meep_local_error GET "${_meep_local}" mklRoot)
    if(_meep_local_error)
      message(FATAL_ERROR "Invalid windows.local.json; rerun tools/windows/setup.ps1")
    endif()
  endif()
  if(NOT MKL_ROOT)
    foreach(_meep_program_files "$ENV{ProgramFiles\(x86\)}" "$ENV{ProgramFiles}")
      foreach(_meep_version "${_meep_mkl_directory_version}" "${MEEP_MKL_REQUIRED_VERSION}")
        set(_meep_candidate "${_meep_program_files}/Intel/oneAPI/mkl/${_meep_version}")
        if(EXISTS "${_meep_candidate}/lib/cmake/mkl/MKLConfig.cmake")
          set(MKL_ROOT "${_meep_candidate}")
          break()
        endif()
      endforeach()
      if(MKL_ROOT)
        break()
      endif()
    endforeach()
  endif()
endif()
if(NOT MKL_ROOT)
  message(FATAL_ERROR "Install standalone Intel oneMKL ${MEEP_MKL_REQUIRED_VERSION} and run tools/windows/setup.ps1. See WINDOWS_BUILD.md.")
endif()
file(TO_CMAKE_PATH "${MKL_ROOT}" MKL_ROOT)
get_filename_component(MKL_ROOT "${MKL_ROOT}" REALPATH)
_meep_mkl_is_python_environment("${MKL_ROOT}" _meep_selected_python_mkl)
if(_meep_selected_python_mkl)
  message(FATAL_ERROR "The selected MKL_ROOT '${MKL_ROOT}' points to a Python environment. Set mklRoot in windows.local.json to the standalone Intel oneMKL SDK. See WINDOWS_BUILD.md.")
endif()
foreach(_meep_required include/mkl.h include/mkl_version.h include/fftw/fftw3.h lib/cmake/mkl/MKLConfig.cmake)
  if(NOT EXISTS "${MKL_ROOT}/${_meep_required}")
    message(FATAL_ERROR "Incomplete standalone oneMKL SDK: ${MKL_ROOT}/${_meep_required}")
  endif()
endforeach()
set(MKL_ROOT "${MKL_ROOT}" CACHE PATH "Standalone Intel oneMKL SDK" FORCE)
if(NOT DEFINED MEEP_MKL_LAST_ROOT OR NOT MEEP_MKL_LAST_ROOT STREQUAL MKL_ROOT)
  get_cmake_property(_meep_cached_variables CACHE_VARIABLES)
  foreach(_meep_cached IN LISTS _meep_cached_variables)
    if(_meep_cached STREQUAL "MKL_INCLUDE" OR _meep_cached MATCHES "^mkl_.*_file$")
      unset("${_meep_cached}" CACHE)
    endif()
  endforeach()
endif()
set(MEEP_MKL_LAST_ROOT "${MKL_ROOT}" CACHE INTERNAL "oneMKL SDK used by this build" FORCE)
# Do not let a previous pip-based MKL_DIR redirect find_package to another SDK.
set(MKL_DIR "${MKL_ROOT}/lib/cmake/mkl" CACHE PATH "Selected oneMKL CMake package" FORCE)
set(MKL_INTERFACE lp64)
set(MKL_THREADING sequential)
set(MKL_LINK dynamic)
find_package(MKL ${MEEP_MKL_REQUIRED_VERSION} EXACT CONFIG REQUIRED PATHS "${MKL_DIR}" NO_DEFAULT_PATH)
set(MEEP_FFTW_INCLUDE_DIR "${MKL_ROOT}/include/fftw" CACHE PATH "Selected oneMKL FFTW3 headers" FORCE)

unset(MEEP_MKL_RUNTIME_DIR)
foreach(_meep_relative bin bin/intel64 redist/intel64 redist/intel64_win/mkl)
  file(GLOB _meep_sequential "${MKL_ROOT}/${_meep_relative}/mkl_sequential*.dll")
  if(_meep_sequential)
    set(MEEP_MKL_RUNTIME_DIR "${MKL_ROOT}/${_meep_relative}")
    break()
  endif()
endforeach()
if(NOT MEEP_MKL_RUNTIME_DIR)
  message(FATAL_ERROR "The selected standalone SDK has no sequential CPU runtime")
endif()
file(GLOB MEEP_MKL_RUNTIME "${MEEP_MKL_RUNTIME_DIR}/mkl_core*.dll"
  "${MEEP_MKL_RUNTIME_DIR}/mkl_sequential*.dll"
  "${MEEP_MKL_RUNTIME_DIR}/mkl_avx*.dll" "${MEEP_MKL_RUNTIME_DIR}/mkl_def*.dll"
  "${MEEP_MKL_RUNTIME_DIR}/mkl_vml*.dll" "${MEEP_MKL_RUNTIME_DIR}/mkl_mc*.dll")
set(MEEP_MKL_LICENSE "" CACHE FILEPATH "Intel SDK redistribution license (auto-detected by default)")
if(NOT MEEP_MKL_LICENSE)
  foreach(_meep_license share/doc/mkl/licensing/license.rtf share/doc/mkl/licensing/license.txt share/doc/mkl/licensing/LICENSE.txt
      licensing/license.txt LICENSE.txt license.txt)
    if(EXISTS "${MKL_ROOT}/${_meep_license}")
      set(MEEP_MKL_LICENSE "${MKL_ROOT}/${_meep_license}" CACHE FILEPATH "Intel SDK redistribution license" FORCE)
      break()
    endif()
  endforeach()
endif()
if(MEEP_BUILD_PYTHON AND NOT EXISTS "${MEEP_MKL_LICENSE}")
  message(FATAL_ERROR "Intel SDK license not found. Set MEEP_MKL_LICENSE to the license supplied with standalone oneMKL.")
endif()
message(STATUS "Meep standalone oneMKL ${MKL_VERSION}: ${MKL_ROOT}")
message(STATUS "Meep oneMKL CPU DLLs: ${MEEP_MKL_RUNTIME_DIR}")
file(GLOB MEEP_MKL_NOTICES "${MKL_ROOT}/share/doc/mkl/licensing/third-party-programs*.txt")
add_library(meep_numerics INTERFACE)
target_link_libraries(meep_numerics INTERFACE MKL::MKL)
target_include_directories(meep_numerics INTERFACE "${MEEP_FFTW_INCLUDE_DIR}")

# Stage the runtime next to native executables so F5 also works without SDK PATH.
get_property(_meep_multi_config GLOBAL PROPERTY GENERATOR_IS_MULTI_CONFIG)
if(_meep_multi_config)
  set(_meep_exe_directory "${PROJECT_BINARY_DIR}/$<CONFIG>")
else()
  set(_meep_exe_directory "${PROJECT_BINARY_DIR}")
endif()
add_custom_target(meep_runtime
  COMMAND "${CMAKE_COMMAND}" -E make_directory "${_meep_exe_directory}"
  COMMAND "${CMAKE_COMMAND}" -E copy_if_different ${MEEP_MKL_RUNTIME} "${_meep_exe_directory}"
  COMMAND_EXPAND_LISTS VERBATIM)
