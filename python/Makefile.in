	$(MAKE) $(AM_MAKEFLAGS) uninstall-hook
.MAKE: all check check-am install install-am install-data-am \
	install-exec install-strip uninstall-am

.PHONY: CTAGS GTAGS TAGS all all-am all-local am--depfiles check \
	check-TESTS check-am clean clean-generic clean-libtool \
	clean-local clean-pkgpyexecLTLIBRARIES clean-pympbLTLIBRARIES \
	cscopelist-am ctags ctags-am distclean distclean-compile \
	distclean-generic distclean-libtool distclean-local \
	distclean-tags distdir dvi dvi-am html html-am info info-am \
	install install-adjointPYTHON install-am install-data \
	install-data-am install-data-hook install-dvi install-dvi-am \
	install-exec install-exec-am install-html install-html-am \
	install-info install-info-am install-man install-pdf \
	install-pdf-am install-pkgpyexecLTLIBRARIES \
	install-pkgpythonPYTHON install-ps install-ps-am \
	install-pympbLTLIBRARIES install-pympbPYTHON install-strip \
	installcheck installcheck-am installdirs maintainer-clean \
	maintainer-clean-generic mostlyclean mostlyclean-compile \
	mostlyclean-generic mostlyclean-libtool pdf pdf-am ps ps-am \
	recheck tags tags-am uninstall uninstall-adjointPYTHON \
	uninstall-am uninstall-hook uninstall-pkgpyexecLTLIBRARIES \
	uninstall-pkgpythonPYTHON uninstall-pympbLTLIBRARIES \
	uninstall-pympbPYTHON

.PRECIOUS: Makefile


@WITH_MPB_TRUE@install-data-hook:
@WITH_MPB_TRUE@	mv $(DESTDIR)$(pkgpythondir)/mpb/mpb.py $(DESTDIR)$(pkgpythondir)/mpb/__init__.py

@WITH_MPB_TRUE@uninstall-hook:
@WITH_MPB_TRUE@	rm -f $(DESTDIR)$(pkgpythondir)/mpb/__init__.py

@MAINTAINER_MODE_TRUE@meep-python.cxx: $(MEEP_SWIG_SRC) $(HPPFILES)
@MAINTAINER_MODE_TRUE@	$(SWIG) -Wextra $(SWIG_MEEP_FLAGS) $(AM_CPPFLAGS) -outdir $(builddir) -c++ -nofastunpack -python -o $@ $(srcdir)/meep.i
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@mpb-python.cxx: $(MPB_SWIG_SRC) $(top_srcdir)/libpympb/pympb.hpp $(top_srcdir)/src/meepgeom.hpp $(top_srcdir)/src/material_data.hpp $(top_srcdir)/src/material_data.cpp
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@	$(SWIG) -Wextra $(AM_CPPFLAGS) $(PYMPBINCLUDE) -outdir $(builddir) -c++ -nofastunpack -python -o $@ $(srcdir)/mpb.i
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@mpb.py: mpb-python.cxx

@MAINTAINER_MODE_TRUE@meep.py: meep-python.cxx

@MAINTAINER_MODE_TRUE@__init__.py: meep.py $(MPB_PY)
@MAINTAINER_MODE_TRUE@	cp $< $@
@MAINTAINER_MODE_TRUE@	echo "__version__ = '@VERSION@'" >> $@
@MAINTAINER_MODE_TRUE@	if [[ "${SWIG_VERSION}" = 3.0.12 ]]; then \
@MAINTAINER_MODE_TRUE@		sed -i.bak '/^if _swig_python_version_info >= (2, 7, 0):/,/^else:/d' $@; \
@MAINTAINER_MODE_TRUE@		sed -i.bak 's/    import _meep/from . import _meep/' $@; \
@MAINTAINER_MODE_TRUE@	fi
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@	if [[ "${SWIG_VERSION}" == 3.0.12 ]]; then \
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@		sed -i.bak '/^if _swig_python_version_info >= (2, 7, 0):/,/^else:/d' mpb.py; \
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@		sed -i.bak 's/    import _mpb/from . import _mpb/' mpb.py; \
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@	fi

meep: _meep.la $(MPB_LA) __init__.py $(HL_IFACE) $(adjoint_PYTHON)
	mkdir -p meep/adjoint
	cp $(PY_PKG_FILES) meep
	cp .libs/_meep$(PYMODULE_BUILT_EXT) meep/_meep$(PYMODULE_EXT)
	cp $(adjoint_PYTHON) meep/adjoint
@WITH_MPB_TRUE@	mkdir -p meep/mpb
@WITH_MPB_TRUE@	cp .libs/_mpb$(PYMODULE_BUILT_EXT) meep/mpb/_mpb$(PYMODULE_EXT)
@WITH_MPB_TRUE@	cp $(MPB_PY_PATH) meep/mpb/__init__.py
@WITH_MPB_TRUE@	cp $(srcdir)/solver.py $(srcdir)/mpb_data.py meep/mpb

all-local: meep

check-adjoint:
	$(MAKE) check TESTS="$(ADJOINT_TESTS)"

clean-local:
	rm -rf meep __init__.py.bak

distclean-local:
	rm -f *.h5
	rm -f *.mp4
	rm -f *.gif

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
