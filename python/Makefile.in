##################################################
# description of unit tests
##################################################
TEST_DIR = tests
@WITH_MPI_FALSE@MDPYTEST = $(TEST_DIR)/test_material_dispersion.py

# material_dispersion.py test must be excluded from test suite for MPI build
@WITH_MPI_TRUE@MDPYTEST = 
@WITH_MPB_FALSE@MPBPYTEST = 
@WITH_MPB_TRUE@MPBPYTEST = $(TEST_DIR)/test_mpb.py
@WITH_MPB_FALSE@BINARY_GRATING_TEST = 
@WITH_MPB_TRUE@BINARY_GRATING_TEST = $(TEST_DIR)/test_binary_grating.py
@WITH_MPB_FALSE@DIFFRACTED_PLANEWAVE_TEST = 
@WITH_MPB_TRUE@DIFFRACTED_PLANEWAVE_TEST = $(TEST_DIR)/test_diffracted_planewave.py
@WITH_MPB_FALSE@DISPERSIVE_EIGENMODE_TEST = 
@WITH_MPB_TRUE@DISPERSIVE_EIGENMODE_TEST = $(TEST_DIR)/test_dispersive_eigenmode.py
@WITH_MPB_FALSE@KDOM_TEST = 
@WITH_MPB_TRUE@KDOM_TEST = $(TEST_DIR)/test_kdom.py
@WITH_MPB_FALSE@MODE_COEFFS_TEST = 
@WITH_MPB_TRUE@MODE_COEFFS_TEST = $(TEST_DIR)/test_mode_coeffs.py
@WITH_MPB_FALSE@MODE_DECOMPOSITION_TEST = 
@WITH_MPB_TRUE@MODE_DECOMPOSITION_TEST = $(TEST_DIR)/test_mode_decomposition.py
@WITH_MPB_FALSE@WVG_SRC_TEST = 
@WITH_MPB_TRUE@WVG_SRC_TEST = $(TEST_DIR)/test_wvg_src.py
ADJOINT_TESTS = \
    $(TEST_DIR)/test_adjoint_solver.py         \
    $(TEST_DIR)/test_adjoint_utils.py          \
    $(TEST_DIR)/test_adjoint_cyl.py            \
    $(TEST_DIR)/test_adjoint_jax.py

@WITH_COVERAGE_FALSE@PY_LOG_COMPILER = $(RUNCODE) $(PYTHON)
@WITH_COVERAGE_TRUE@PY_LOG_COMPILER = coverage run -p --source=$(top_srcdir)/python/meep --omit=$(top_srcdir)/python/tests/*,$(top_srcdir)/python/examples/*,$(top_srcdir)/python/meep/materials.py
TEST_EXTENSIONS = .py
TESTS_ENVIRONMENT = export PYTHONPATH="`$(PYPATH_CONV) $(abs_top_builddir)/python`$(PYPATH_SEP)$$PYTHONPATH";

######################################################################
# instructions for building the _meep binary library that implements
# the low-level interface between python codes and the libmeep C++ library
######################################################################
BUILT_SOURCES = meep-python.cxx __init__.py meep.py $(am__append_1)
EXTRA_DIST = $(BUILT_SOURCES) meep.i meep-python.hpp typemap_utils.cpp \
	materials.py examples tests $(am__append_2)
CLEANFILES = .coverage
MAINTAINERCLEANFILES = $(BUILT_SOURCES)
AM_CPPFLAGS = -I$(top_srcdir)/src               \
              -I$(top_srcdir)/libpympb		\
              -I$(top_builddir) # for config.h

LIBMEEP = $(top_builddir)/src/libmeep.la
SWIG_WARN_FLAGS = -Wno-unused-function -Wno-unused-parameter -Wno-missing-field-initializers
_meep_la_SOURCES = meep-python.cxx
_meep_la_LIBADD = $(LIBMEEP) $(PYTHON_LIBS)
_meep_la_LDFLAGS = -module $(PYMODULE_LDFLAGS) -avoid-version
_meep_la_CPPFLAGS = $(PYTHON_INCLUDES) $(AM_CPPFLAGS) $(SWIG_WARN_FLAGS)
_meep_la_CXXFLAGS = -O1
pkgpyexec_LTLIBRARIES = _meep.la
@WITH_MPB_TRUE@MPB_LA = _mpb.la
@WITH_MPB_TRUE@pympbdir = $(pkgpythondir)/mpb
@WITH_MPB_TRUE@pympb_PYTHON = mpb.py solver.py mpb_data.py
@WITH_MPB_TRUE@pympb_LTLIBRARIES = _mpb.la
@WITH_MPB_TRUE@_mpb_la_SOURCES = mpb-python.cxx
@WITH_MPB_TRUE@_mpb_la_LIBADD = $(PYTHON_LIBS) $(top_builddir)/libpympb/libpympb.la $(LIBMEEP)
@WITH_MPB_TRUE@_mpb_la_LDFLAGS = -module $(PYMODULE_LDFLAGS) -avoid-version
@WITH_MPB_TRUE@_mpb_la_CPPFLAGS = $(PYTHON_INCLUDES) $(AM_CPPFLAGS) $(SWIG_WARN_FLAGS)
@WITH_MPB_TRUE@_mpb_la_CXXFLAGS = -O1

##################################################
# instructions for running SWIG to generate the
# source files for the previous step
##################################################
@MAINTAINER_MODE_TRUE@SWIG_VERSION = $(shell $(SWIG) -version | grep Version | awk '{print $$3}')
@MAINTAINER_MODE_TRUE@MEEP_SWIG_SRC = meep.i numpy.i vec.i
@MAINTAINER_MODE_TRUE@HPPFILES = \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/meep.hpp                  \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/meep_internals.hpp        \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/bicgstab.hpp              \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/meep/vec.hpp              \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/meep/mympi.hpp            \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/meepgeom.hpp              \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/material_data.hpp         \
@MAINTAINER_MODE_TRUE@ $(top_srcdir)/src/adjust_verbosity.hpp      \
@MAINTAINER_MODE_TRUE@ meep-python.hpp

@MAINTAINER_MODE_TRUE@@MEEP_SWIG_PYTHON_THREADS_TRUE@SWIG_MEEP_FLAGS = -threads
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@MPB_SWIG_SRC = mpb.i
@MAINTAINER_MODE_TRUE@@WITH_MPB_TRUE@MPB_PY = mpb.py
@MAINTAINER_MODE_FALSE@INIT_PY = $(srcdir)/__init__.py
@MAINTAINER_MODE_TRUE@INIT_PY = __init__.py
@MAINTAINER_MODE_FALSE@MPB_PY_PATH = $(srcdir)/mpb.py
@MAINTAINER_MODE_TRUE@MPB_PY_PATH = $(builddir)/mpb.py

######################################################################
# specification of python source files to be byte-compiled at installation
######################################################################
HL_IFACE = \
    $(srcdir)/binary_partition_utils.py       \
    $(srcdir)/chunk_balancer.py       \
    $(srcdir)/geom.py       \
    $(srcdir)/simulation.py \
    $(srcdir)/source.py     \
    $(srcdir)/timing_measurements.py       \
    $(srcdir)/visualization.py  \
    $(srcdir)/materials.py  \
    $(srcdir)/verbosity_mgr.py

pkgpython_PYTHON = __init__.py $(HL_IFACE)
adjointdir = $(pkgpythondir)/adjoint
adjoint_PYTHON = $(srcdir)/adjoint/__init__.py              \
                  $(srcdir)/adjoint/basis.py                 \
                  $(srcdir)/adjoint/objective.py             \
                  $(srcdir)/adjoint/optimization_problem.py  \
                  $(srcdir)/adjoint/filters.py               \
                  $(srcdir)/adjoint/filter_source.py         \
                  $(srcdir)/adjoint/connectivity.py         \
                  $(srcdir)/adjoint/unfilter_design.py        \
                  $(srcdir)/adjoint/wrapper.py               \
                  $(srcdir)/adjoint/utils.py

PY_PKG_FILES = $(INIT_PY) $(HL_IFACE)
all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .cxx .lo .log .o .obj .py .py$(EXEEXT) .trs
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign python/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign python/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):

install-pkgpyexecLTLIBRARIES: $(pkgpyexec_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(pkgpyexec_LTLIBRARIES)'; test -n "$(pkgpyexecdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pkgpyexecdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pkgpyexecdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(pkgpyexecdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(pkgpyexecdir)"; \
	}

uninstall-pkgpyexecLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(pkgpyexec_LTLIBRARIES)'; test -n "$(pkgpyexecdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(pkgpyexecdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(pkgpyexecdir)/$$f"; \
	done

clean-pkgpyexecLTLIBRARIES:
	-$(am__rm_f) $(pkgpyexec_LTLIBRARIES)
	@list='$(pkgpyexec_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

install-pympbLTLIBRARIES: $(pympb_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(pympb_LTLIBRARIES)'; test -n "$(pympbdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pympbdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pympbdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(pympbdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(pympbdir)"; \
	}

uninstall-pympbLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(pympb_LTLIBRARIES)'; test -n "$(pympbdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(pympbdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(pympbdir)/$$f"; \
	done

clean-pympbLTLIBRARIES:
	-$(am__rm_f) $(pympb_LTLIBRARIES)
	@list='$(pympb_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

_meep.la: $(_meep_la_OBJECTS) $(_meep_la_DEPENDENCIES) $(EXTRA__meep_la_DEPENDENCIES) 
	$(AM_V_CXXLD)$(_meep_la_LINK) -rpath $(pkgpyexecdir) $(_meep_la_OBJECTS) $(_meep_la_LIBADD) $(LIBS)

_mpb.la: $(_mpb_la_OBJECTS) $(_mpb_la_DEPENDENCIES) $(EXTRA__mpb_la_DEPENDENCIES) 
	$(AM_V_CXXLD)$(_mpb_la_LINK) $(am__mpb_la_rpath) $(_mpb_la_OBJECTS) $(_mpb_la_LIBADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/_meep_la-meep-python.Plo@am__quote@ # am--include-marker
@AMDEP_TRUE@@am__include@ @am__quote@./$(DEPDIR)/_mpb_la-mpb-python.Plo@am__quote@ # am--include-marker

$(am__depfiles_remade):
	@$(MKDIR_P) $(@D)
	@: >>$@

am--depfiles: $(am__depfiles_remade)

.cxx.o:
@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(CXXCOMPILE) -MT $@ -MD -MP -MF $(DEPDIR)/$*.Tpo -c -o $@ $<
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/$*.Tpo $(DEPDIR)/$*.Po
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	$(AM_V_CXX)source='$<' object='$@' libtool=no @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	DEPDIR=$(DEPDIR) $(CXXDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCXX_FALSE@	$(AM_V_CXX@am__nodep@)$(CXXCOMPILE) -c -o $@ $<

.cxx.obj:
@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(CXXCOMPILE) -MT $@ -MD -MP -MF $(DEPDIR)/$*.Tpo -c -o $@ `$(CYGPATH_W) '$<'`
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/$*.Tpo $(DEPDIR)/$*.Po
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	$(AM_V_CXX)source='$<' object='$@' libtool=no @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	DEPDIR=$(DEPDIR) $(CXXDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCXX_FALSE@	$(AM_V_CXX@am__nodep@)$(CXXCOMPILE) -c -o $@ `$(CYGPATH_W) '$<'`

.cxx.lo:
@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(LTCXXCOMPILE) -MT $@ -MD -MP -MF $(DEPDIR)/$*.Tpo -c -o $@ $<
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/$*.Tpo $(DEPDIR)/$*.Plo
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	$(AM_V_CXX)source='$<' object='$@' libtool=yes @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	DEPDIR=$(DEPDIR) $(CXXDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCXX_FALSE@	$(AM_V_CXX@am__nodep@)$(LTCXXCOMPILE) -c -o $@ $<

_meep_la-meep-python.lo: meep-python.cxx
@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(_meep_la_CPPFLAGS) $(CPPFLAGS) $(_meep_la_CXXFLAGS) $(CXXFLAGS) -MT _meep_la-meep-python.lo -MD -MP -MF $(DEPDIR)/_meep_la-meep-python.Tpo -c -o _meep_la-meep-python.lo `test -f 'meep-python.cxx' || echo '$(srcdir)/'`meep-python.cxx
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/_meep_la-meep-python.Tpo $(DEPDIR)/_meep_la-meep-python.Plo
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	$(AM_V_CXX)source='meep-python.cxx' object='_meep_la-meep-python.lo' libtool=yes @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	DEPDIR=$(DEPDIR) $(CXXDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCXX_FALSE@	$(AM_V_CXX@am__nodep@)$(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(_meep_la_CPPFLAGS) $(CPPFLAGS) $(_meep_la_CXXFLAGS) $(CXXFLAGS) -c -o _meep_la-meep-python.lo `test -f 'meep-python.cxx' || echo '$(srcdir)/'`meep-python.cxx

_mpb_la-mpb-python.lo: mpb-python.cxx
@am__fastdepCXX_TRUE@	$(AM_V_CXX)$(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(_mpb_la_CPPFLAGS) $(CPPFLAGS) $(_mpb_la_CXXFLAGS) $(CXXFLAGS) -MT _mpb_la-mpb-python.lo -MD -MP -MF $(DEPDIR)/_mpb_la-mpb-python.Tpo -c -o _mpb_la-mpb-python.lo `test -f 'mpb-python.cxx' || echo '$(srcdir)/'`mpb-python.cxx
@am__fastdepCXX_TRUE@	$(AM_V_at)$(am__mv) $(DEPDIR)/_mpb_la-mpb-python.Tpo $(DEPDIR)/_mpb_la-mpb-python.Plo
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	$(AM_V_CXX)source='mpb-python.cxx' object='_mpb_la-mpb-python.lo' libtool=yes @AMDEPBACKSLASH@
@AMDEP_TRUE@@am__fastdepCXX_FALSE@	DEPDIR=$(DEPDIR) $(CXXDEPMODE) $(depcomp) @AMDEPBACKSLASH@
@am__fastdepCXX_FALSE@	$(AM_V_CXX@am__nodep@)$(LIBTOOL) $(AM_V_lt) --tag=CXX $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=compile $(CXX) $(DEFS) $(DEFAULT_INCLUDES) $(INCLUDES) $(_mpb_la_CPPFLAGS) $(CPPFLAGS) $(_mpb_la_CXXFLAGS) $(CXXFLAGS) -c -o _mpb_la-mpb-python.lo `test -f 'mpb-python.cxx' || echo '$(srcdir)/'`mpb-python.cxx

mostlyclean-libtool:
	-rm -f *.lo

clean-libtool:
	-rm -rf .libs _libs
install-adjointPYTHON: $(adjoint_PYTHON)
	@$(NORMAL_INSTALL)
	@list='$(adjoint_PYTHON)'; dlist=; list2=; test -n "$(adjointdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(adjointdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(adjointdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then b=; else b="$(srcdir)/"; fi; \
	  if test -f $$b$$p; then \
	    $(am__strip_dir) \
	    dlist="$$dlist $$f"; \
	    list2="$$list2 $$b$$p"; \
	  else :; fi; \
	done; \
	for file in $$list2; do echo $$file; done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(adjointdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(adjointdir)" || exit $$?; \
	done || exit $$?; \
	if test -n "$$dlist"; then \
	  $(am__py_compile) --destdir "$(DESTDIR)" \
	                    --basedir "$(adjointdir)" $$dlist; \
	else :; fi

uninstall-adjointPYTHON:
	@$(NORMAL_UNINSTALL)
	@list='$(adjoint_PYTHON)'; test -n "$(adjointdir)" || list=; \
	py_files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	test -n "$$py_files" || exit 0; \
	dir='$(DESTDIR)$(adjointdir)'; \
	pyc_files=`echo "$$py_files" | sed 's|$$|c|'`; \
	pyo_files=`echo "$$py_files" | sed 's|$$|o|'`; \
	st=0; \
	for files in "$$py_files" "$$pyc_files" "$$pyo_files"; do \
	  $(am__uninstall_files_from_dir) || st=$$?; \
	done; \
	dir='$(DESTDIR)$(adjointdir)'; \
	files=`echo "$$py_files" | $(am__pep3147_tweak)`; \
	$(am__uninstall_files_from_dir) || st=$$?; \
	exit $$st
